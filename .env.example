# Copia este archivo como .env y rellénalo. NUNCA lo subas al repositorio ni lo pegues en un chat.

# Perfil de la empresa (lo único que cambia de un cliente a otro).
# Demo: config/empresa.demo.yaml · Producción: copia config/empresa.plantilla.yaml a config/empresa.yaml
EMPRESA_CONFIG=config/empresa.demo.yaml

# Telegram: token de @BotFather (formato 123456789:AAH...) e IDs numéricos autorizados (te los da @userinfobot),
# separados por comas. Es el ÚNICO bot del sistema: el Agente Interno se despliega sin el suyo.
TELEGRAM_BOT_TOKEN=          # también se acepta con el nombre TELEGRAM_BOT_API
TELEGRAM_USUARIOS=

# Claude: clave de API de https://console.anthropic.com (Settings → API keys, empieza por sk-ant-).
# La usa el orquestador y, en modo "agente", el Agente Externo.
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-sonnet-5-5
# 0 = no llamar nunca a Claude (p. ej. sin créditos): funcionan /panel, /oportunidades, /negocio, resumen y alertas
CLAUDE_ACTIVO=1

# Agente Interno: modo api (producción) o demo (respuestas capturadas). Token compartido con su API /v1/consulta.
INTERNO_MODO=demo
INTERNO_URL=http://agente-interno:8080/v1/consulta
ORQUESTADOR_TOKEN=

# Agente Externo (Revolico y Cuballama): opcionales, ver el README del Controlador de Mercado
# Directorio del histórico de capturas (sin él no hay tendencias). En Docker ya se fija en el volumen.
CONTROLADOR_CACHE_DIR=
CONTROLADOR_SELLER_HASH_KEY=
# Tasa USD→CUP del día (elTOQUE): el panel y el bot dan los importes en CUP a esta tasa con su equivalente en USD.
# Sin clave se usa la última tasa del Agente Interno (en el modo demo, la del 30/09/2026).
ELTOQUE_API_KEY=

# Web del panel. Genera un token largo: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_HOST=0.0.0.0
API_PORT=8090
PANEL_TOKEN=
# Vacío = el bot envía el panel como archivo HTML (opción elegida). Solo si se publica detrás de un proxy HTTPS:
PANEL_URL_PUBLICA=

# Hora congelada del modo demo (vacío = hora real). Si no se define, se usa la del perfil.
# AHORA_FIJA=
