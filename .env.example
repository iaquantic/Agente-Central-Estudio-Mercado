# Copia este archivo como .env y rellénalo. NUNCA lo subas al repositorio ni lo pegues en un chat.

# Perfil de la empresa (lo único que cambia de un cliente a otro). Por defecto, el de demostración.
EMPRESA_CONFIG=config/empresa.demo.yaml

# Telegram: token de @BotFather e IDs numéricos autorizados (te los da @userinfobot), separados por comas
TELEGRAM_BOT_TOKEN=
TELEGRAM_USUARIOS=

# Claude (https://console.anthropic.com). Lo usan el orquestador y, en modo "agente", el Agente Externo.
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-opus-5-5

# Agente Interno: modo api (producción) o demo (respuestas capturadas). Token compartido con su API /v1/consulta.
INTERNO_MODO=demo
INTERNO_URL=http://agente-interno:8080/v1/consulta
ORQUESTADOR_TOKEN=

# Agente Externo: claves opcionales del Controlador de Mercado (ver su README)
ELTOQUE_API_KEY=
CONTROLADOR_SELLER_HASH_KEY=

# Web del panel. Genera un token largo: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_HOST=0.0.0.0
API_PORT=8090
PANEL_TOKEN=
# URL pública del panel (si se publica detrás de un proxy HTTPS); el bot la incluye en sus mensajes
PANEL_URL_PUBLICA=

# Hora congelada del modo demo (vacío = hora real). Si no se define, se usa la del perfil.
# AHORA_FIJA=
