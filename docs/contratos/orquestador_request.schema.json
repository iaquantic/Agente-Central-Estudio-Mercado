{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orquestador_request.schema.json",
  "title": "Petición del Agente Orquestador al Agente Interno (v1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "version", "type", "requested_at"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "version": { "const": "1.0" },
    "type": { "enum": ["report", "question", "tool"] },
    "report": { "enum": ["estado_general", "ventas", "inventario", "rentabilidad", "alertas", "calidad_datos"] },
    "question": { "type": "string", "minLength": 2, "maxLength": 500 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["get_business_summary", "get_sales_summary", "get_top_products", "find_products",
                           "get_product", "get_product_history", "get_inventory_status", "get_margin_analysis",
                           "get_alerts", "get_returns_and_voids", "get_exchange_rate", "get_data_quality"] },
        "params": { "type": "object" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } }
    },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "report" } } }, "then": { "required": ["report"] } },
    { "if": { "properties": { "type": { "const": "question" } } }, "then": { "required": ["question"] } },
    { "if": { "properties": { "type": { "const": "tool" } } }, "then": { "required": ["tool"] } }
  ]
}
