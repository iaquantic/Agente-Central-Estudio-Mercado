{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orquestador_response.schema.json",
  "title": "Respuesta del Agente Interno al Agente Orquestador (v1.0)",
  "type": "object",
  "required": ["request_id", "version", "status", "generated_at"],
  "properties": {
    "request_id": { "type": "string" },
    "version": { "const": "1.0" },
    "status": { "enum": ["ok", "partial", "no_data", "out_of_scope", "error"] },
    "summary": { "type": "string" },
    "period": {
      "type": "object",
      "required": ["from", "to", "timezone"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "timezone": { "const": "America/Havana" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit", "kind"],
        "properties": {
          "value": { "type": ["number", "null"] },
          "value_cup": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "kind": { "enum": ["fact", "calculation"] },
          "definition": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "category", "title"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["fact", "calculation", "inference"] },
          "category": { "enum": ["ventas", "inventario", "rentabilidad", "devoluciones", "anulaciones", "tasa", "calidad_datos"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "evidence": { "type": "object" },
          "confidence": { "enum": ["high", "medium", "low"] }
        },
        "if": { "properties": { "kind": { "const": "inference" } } },
        "then": { "required": ["confidence"] }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_key", "rule", "priority", "title", "detected_at"],
        "properties": {
          "id": { "type": "string" },
          "alert_key": { "type": "string" },
          "rule": { "type": "string" },
          "priority": { "enum": ["urgent", "high", "medium", "low"] },
          "category": { "type": "string" },
          "product": {
            "type": ["object", "null"],
            "properties": { "sku": { "type": "string" }, "name": { "type": "string" } }
          },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "current_value": { "type": ["number", "null"] },
          "threshold": { "type": ["number", "null"] },
          "detected_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "not_available": {
      "type": "array",
      "items": { "type": "object", "required": ["item", "reason"],
                 "properties": { "item": { "type": "string" }, "reason": { "type": "string" } } }
    },
    "data_quality": {
      "type": "object",
      "properties": {
        "last_data_at": { "type": ["string", "null"], "format": "date-time" },
        "freshness_minutes": { "type": ["number", "null"] },
        "fx": { "type": "object", "properties": { "date": { "type": "string" }, "usd_cup": { "type": "number" }, "source": { "type": "string" } } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tools_used": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["unauthorized", "invalid_request", "unsupported_version", "timeout", "internal"] },
        "message": { "type": "string" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "if": { "properties": { "status": { "const": "error" } } },
  "then": { "required": ["error"] },
  "else": { "required": ["summary", "period", "data_quality", "tools_used"] }
}
